#!/usr/bin/env python3
"""omabeacon: per-workspace purpose beacons, local process sensing, and state CLI."""

from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile
import time
from collections import Counter
from pathlib import Path

STATE_DIR = Path.home() / ".local" / "state" / "omarchy" / "omabeacon"
STATE_FILE = STATE_DIR / "state.json"
VAULT_DIR = STATE_DIR / "vault"
OPEN_MODE_FILE = STATE_DIR / "open_mode"

VALID_FX = ("scramble",)
VALID_HUD_STYLES = ("glitch", "wire", "laser", "arcade", "cyber", "dos", "radar", "sine", "vhs")
VALID_HUD_POS = ("top", "center", "bottom")
VALID_HUD_SIZES = ("sm", "md", "lg", "xl", "xxl", "mega", "giga", "tera")
VALID_HUD_COLORFX = ("low", "mid", "high", "flare")
VALID_HUD_CASE = ("upper", "asis", "lower")
VALID_GLYPH_POS = ("off", "above", "below")

PALETTES = {
    "tokyo": ["#f7768e", "#ff9e64", "#e0af68", "#9ece6a", "#73daca", "#7dcfff", "#7aa2f7", "#bb9af7", "#ff79c6", "#c0caf5"],
    "neon": ["#ff0055", "#ff5500", "#ffcc00", "#39ff14", "#00ffcc", "#00e5ff", "#2979ff", "#aa00ff", "#ff00ff", "#ffffff"],
    "pastel": ["#f38ba8", "#fab387", "#f9e2af", "#a6e3a1", "#94e2d5", "#89dceb", "#89b4fa", "#cba6f7", "#f5c2e7", "#cdd6f4"],
    "mono": ["#00ff66", "#22ee77", "#44dd88", "#66cc99", "#88ddaa", "#aaf0cc", "#ccffdd", "#a0c4b0", "#7aa899", "#e0fff0"],
    "fire": ["#ff1e42", "#ff4d2e", "#ff7700", "#ffa600", "#ffd000", "#ffe866", "#fff4b8", "#ff6b6b", "#ff3b8d", "#ffffff"],
}

BINDINGS_FILE = Path.home() / ".config" / "hypr" / "bindings.lua"

TERMINAL_CLASSES = {
    "alacritty",
    "kitty",
    "foot",
    "footclient",
    "com.mitchellh.ghostty",
    "ghostty",
    "org.wezfurlong.wezterm",
    "wezterm",
    "st-256color",
    "urxvt",
    "xterm",
}

SHELL_NAMES = {"bash", "zsh", "fish", "sh", "dash", "nu", "elvish", "tmux"}


def default_state() -> dict:
    return {
        "version": 1,
        "fx": "scramble",
        "autoSense": True,
        "flashHud": True,
        "hudStyle": "glitch",
        "hudPos": "center",
        "hudSize": "mega",
        "hudColorFx": "mid",
        "hudCase": "upper",
        "palette": "tokyo",
        "glyphPos": "above",
        "keybind": "SUPER + N",
        "extraKeys": True,
        "hudPreviewSeq": 0,
        "hudOverrideText": "",
        "hudOverrideColor": "",
        "workspaces": {},
    }


def load_state() -> dict:
    if not STATE_FILE.exists():
        return default_state()
    try:
        data = json.loads(STATE_FILE.read_text(encoding="utf-8"))
        if not isinstance(data, dict):
            return default_state()
    except Exception:
        return default_state()

    base = default_state()
    base["fx"] = "scramble"
    base["autoSense"] = True if "autoSense" not in data else bool(data.get("autoSense"))
    base["flashHud"] = bool(data.get("flashHud", True))
    raw_style = data.get("hudStyle")
    if raw_style == "brutal":
        raw_style = "glitch"
    base["hudStyle"] = raw_style if raw_style in VALID_HUD_STYLES else "glitch"
    base["hudPos"] = data.get("hudPos") if data.get("hudPos") in VALID_HUD_POS else "center"
    base["hudSize"] = data.get("hudSize") if data.get("hudSize") in VALID_HUD_SIZES else "mega"
    base["hudColorFx"] = data.get("hudColorFx") if data.get("hudColorFx") in VALID_HUD_COLORFX else "mid"
    base["hudCase"] = data.get("hudCase") if data.get("hudCase") in VALID_HUD_CASE else "upper"
    base["palette"] = data.get("palette") if data.get("palette") in PALETTES else "tokyo"
    base["glyphPos"] = data.get("glyphPos") if data.get("glyphPos") in VALID_GLYPH_POS else "above"
    base["keybind"] = str(data.get("keybind") or "SUPER + N")
    base["extraKeys"] = True if "extraKeys" not in data else bool(data.get("extraKeys"))
    base["hudPreviewSeq"] = int(data.get("hudPreviewSeq", 0))
    base["hudOverrideText"] = str(data.get("hudOverrideText") or "")
    base["hudOverrideColor"] = str(data.get("hudOverrideColor") or "")
    ws = data.get("workspaces")
    base["workspaces"] = ws if isinstance(ws, dict) else {}
    return base


def save_state(state: dict) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    fd, tmp_path = tempfile.mkstemp(prefix="state-", suffix=".json", dir=str(STATE_DIR))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(state, f, indent=2, ensure_ascii=False)
            f.write("\n")
        os.replace(tmp_path, STATE_FILE)
    except Exception:
        try:
            os.unlink(tmp_path)
        except OSError:
            pass
        raise


def normalize_ws(ws: str | int) -> str:
    val = int(ws)
    if val < 1 or val > 99:
        raise ValueError(f"Workspace must be >= 1, got {ws}")
    return str(val)


def read_proc_comm(pid: int) -> str:
    try:
        return Path(f"/proc/{pid}/comm").read_text(encoding="utf-8", errors="replace").strip()
    except OSError:
        return ""


def read_proc_cwd(pid: int) -> tuple[str, str]:
    try:
        cwd = os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        return "", ""
    home = str(Path.home())
    if cwd == home:
        return "~", ""
    p = Path(cwd)
    branch = ""
    cur = p
    for _ in range(5):
        head = cur / ".git" / "HEAD"
        if head.is_file():
            try:
                raw = head.read_text(encoding="utf-8", errors="replace").strip()
                if raw.startswith("ref: refs/heads/"):
                    branch = raw[len("ref: refs/heads/"):]
                elif len(raw) >= 7:
                    branch = raw[:7]
            except OSError:
                pass
            break
        if cur.parent == cur or str(cur) == home:
            break
        cur = cur.parent
    return (p.name or cwd), branch


def read_children(pid: int) -> list[int]:
    children: list[int] = []
    task_dir = Path(f"/proc/{pid}/task")
    try:
        for tid_dir in task_dir.iterdir():
            cfile = tid_dir / "children"
            try:
                raw = cfile.read_text(encoding="utf-8", errors="replace").strip()
                if raw:
                    children.extend(int(x) for x in raw.split() if x.isdigit())
            except OSError:
                continue
    except OSError:
        pass
    return children


def deepest_interesting_proc(root_pid: int, max_depth: int = 4) -> tuple[str, str, str]:
    """Walk child processes of a terminal to find the active foreground command, cwd, and git branch."""
    current = root_pid
    best_comm = read_proc_comm(root_pid)
    best_cwd, best_branch = read_proc_cwd(root_pid)

    for _ in range(max_depth):
        kids = read_children(current)
        if not kids:
            break
        # Prefer the most recently spawned child (usually foreground)
        nxt = kids[-1]
        comm = read_proc_comm(nxt)
        cwd, branch = read_proc_cwd(nxt)
        if comm:
            best_comm = comm
        if cwd:
            best_cwd = cwd
            best_branch = branch
        current = nxt

    return best_comm, best_cwd, best_branch


def active_workspace_id() -> int:
    try:
        out = subprocess.check_output(
            ["hyprctl", "activeworkspace", "-j"],
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=1.5,
        )
        return int(json.loads(out).get("id", 1))
    except Exception:
        return 1


def sense_workspace(ws_id: int | None = None) -> dict:
    if ws_id is None:
        ws_id = active_workspace_id()

    try:
        out = subprocess.check_output(
            ["hyprctl", "clients", "-j"],
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=1.5,
        )
        clients = json.loads(out)
    except Exception:
        return {"workspace": ws_id, "windowCount": 0, "summary": "", "details": []}

    ws_clients = [c for c in clients if c.get("workspace", {}).get("id") == ws_id]
    if not ws_clients:
        return {"workspace": ws_id, "windowCount": 0, "summary": "empty", "details": []}

    term_tags: list[str] = []
    other_apps: Counter[str] = Counter()
    details: list[str] = []

    for c in ws_clients:
        cls = (c.get("class") or c.get("initialClass") or "").strip()
        cls_low = cls.lower()
        pid = int(c.get("pid") or 0)
        title = (c.get("title") or "").strip()

        if cls_low in TERMINAL_CLASSES and pid > 0:
            comm, cwd, branch = deepest_interesting_proc(pid)
            loc = f"{cwd}:{branch}" if (cwd and cwd != "~" and branch) else cwd
            if comm in SHELL_NAMES or not comm:
                tag = loc if loc and loc != "~" else (comm or "term")
            else:
                tag = f"{comm}@{loc}" if loc and loc != "~" else comm
            term_tags.append(tag)
            details.append(f"term:{tag}")
        else:
            short_cls = cls.split(".")[-1] if "." in cls else cls
            label = short_cls or title[:18] or "win"
            other_apps[label.lower()] += 1
            details.append(f"{label.lower()}:{title[:30]}")

    parts: list[str] = []
    if term_tags:
        # Deduplicate while preserving order, keep top 3
        seen: list[str] = []
        for t in term_tags:
            if t not in seen:
                seen.append(t)
        shown = ", ".join(seen[:3])
        if len(seen) > 3:
            shown += f" +{len(seen) - 3}"
        prefix = f"{len(term_tags)}×term" if len(term_tags) > 1 else "term"
        parts.append(f"{prefix} ({shown})")

    for app, count in other_apps.most_common(3):
        parts.append(f"{count}×{app}" if count > 1 else app)

    summary = " + ".join(parts)
    if len(summary) > 56:
        summary = summary[:53] + "..."

    return {
        "workspace": ws_id,
        "windowCount": len(ws_clients),
        "summary": summary,
        "details": details,
    }


EXTRA_KEYS_BEGIN = "-- BEGIN omabeacon-extra-keys"
EXTRA_KEYS_END = "-- END omabeacon-extra-keys"

RELAUNCH_TUIS = {"nvim", "vim", "vi", "hx", "lazygit", "btop", "htop", "yazi", "ranger", "less", "man"}


def apply_extra_keys(enabled: bool) -> None:
    if not BINDINGS_FILE.exists():
        return
    txt = BINDINGS_FILE.read_text(encoding="utf-8")
    pattern = re.compile(
        re.escape(EXTRA_KEYS_BEGIN) + r".*?" + re.escape(EXTRA_KEYS_END) + r"\n?",
        re.DOTALL,
    )
    txt = re.sub(pattern, "", txt).rstrip() + "\n"
    if enabled:
        cli_bin = str(Path.home() / ".local" / "bin" / "omabeacon")
        lines = [EXTRA_KEYS_BEGIN]
        for idx in range(1, 11):
            ws = 10 + idx
            lines.append(f'o.bind("SUPER + F{idx}", "Workspace {ws}", hl.dsp.focus({{ workspace = "{ws}" }}))')
        for idx in range(1, 11):
            ws = 10 + idx
            lines.append(f'o.bind("SUPER + SHIFT + F{idx}", "Move to workspace {ws}", hl.dsp.window.move({{ workspace = "{ws}" }}))')
        lines.append(f'o.bind("SUPER + F11", "Cryo-freeze workspace", "{cli_bin} freeze")')
        lines.append(f'o.bind("SUPER + F12", "Open Cryo Vault", "{cli_bin} vault")')
        lines.append(EXTRA_KEYS_END)
        txt = txt + "\n" + "\n".join(lines) + "\n"
    BINDINGS_FILE.write_text(txt, encoding="utf-8")
    subprocess.run(["hyprctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def read_proc_cmdline(pid: int) -> list[str]:
    try:
        raw = Path(f"/proc/{pid}/cmdline").read_bytes()
        parts = [x.decode("utf-8", errors="replace") for x in raw.split(b"\x00") if x]
        if len(parts) == 1 and " " in parts[0]:
            try:
                return shlex.split(parts[0])
            except ValueError:
                return parts[0].split()
        return parts
    except OSError:
        return []


def read_proc_cwd_full(pid: int) -> str:
    try:
        return os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        return str(Path.home())


def deepest_pid(root_pid: int, max_depth: int = 4) -> int:
    cur = root_pid
    for _ in range(max_depth):
        kids = read_children(cur)
        if not kids:
            break
        cur = kids[-1]
    return cur


def get_clients() -> list[dict]:
    try:
        out = subprocess.check_output(
            ["hyprctl", "clients", "-j"],
            text=True,
            stderr=subprocess.DEVNULL,
            timeout=2.0,
        )
        return json.loads(out)
    except Exception:
        return []


def occupied_workspaces(clients: list[dict] | None = None) -> list[int]:
    if clients is None:
        clients = get_clients()
    occ = sorted({
        int(c.get("workspace", {}).get("id", 0))
        for c in clients
        if 1 <= int(c.get("workspace", {}).get("id", 0)) <= 20
    })
    return occ


def build_relaunch_cmd(client: dict) -> dict:
    cls = (client.get("class") or client.get("initialClass") or "").strip()
    cls_low = cls.lower()
    pid = int(client.get("pid") or 0)
    title = (client.get("title") or "").strip()

    if cls_low in TERMINAL_CLASSES and pid > 0:
        deep = deepest_pid(pid)
        cwd = read_proc_cwd_full(deep) or read_proc_cwd_full(pid)
        comm = read_proc_comm(deep)
        cmd_parts = read_proc_cmdline(deep)
        term_bin = cls_low.split(".")[-1]
        if term_bin == "footclient":
            term_bin = "foot"
        if comm in RELAUNCH_TUIS and cmd_parts:
            inner = " ".join(shlex.quote(p) for p in cmd_parts)
            if term_bin == "alacritty":
                launch = f"alacritty --working-directory {shlex.quote(cwd)} -e sh -lc {shlex.quote(inner)}"
            elif term_bin == "kitty":
                launch = f"kitty --directory {shlex.quote(cwd)} sh -lc {shlex.quote(inner)}"
            elif term_bin == "ghostty":
                launch = f"ghostty --working-directory={shlex.quote(cwd)} -e sh -lc {shlex.quote(inner)}"
            else:
                launch = f"{term_bin} -e sh -lc {shlex.quote(f'cd {shlex.quote(cwd)} && {inner}')}"
        else:
            if term_bin == "alacritty":
                launch = f"alacritty --working-directory {shlex.quote(cwd)}"
            elif term_bin == "kitty":
                launch = f"kitty --directory {shlex.quote(cwd)}"
            elif term_bin == "ghostty":
                launch = f"ghostty --working-directory={shlex.quote(cwd)}"
            elif term_bin == "foot":
                launch = f"foot --working-directory={shlex.quote(cwd)}"
            else:
                launch = term_bin
        return {"kind": "term", "class": cls, "title": title, "cwd": cwd, "comm": comm, "exec": launch}

    if cls_low in ("chromium", "google-chrome", "brave-browser", "firefox"):
        launch = cls_low.split("-")[0] if cls_low != "brave-browser" else "brave"
    else:
        cmd_parts = read_proc_cmdline(pid) if pid > 0 else []
        launch = shlex.quote(cmd_parts[0]) if cmd_parts else cls_low
    return {"kind": "app", "class": cls, "title": title, "cwd": "", "comm": cls_low, "exec": launch}


def list_vault() -> dict:
    VAULT_DIR.mkdir(parents=True, exist_ok=True)
    items: list[dict] = []
    for jf in sorted(VAULT_DIR.glob("*.json"), reverse=True):
        try:
            d = json.loads(jf.read_text(encoding="utf-8"))
            items.append(d)
        except Exception:
            continue
    clients = get_clients()
    occ = occupied_workspaces(clients)
    free = [i for i in range(1, 21) if i not in occ]
    return {"items": items, "occupied": occ, "free": free}


def freeze_workspace(state: dict) -> dict:
    ws_id = active_workspace_id()
    clients = [c for c in get_clients() if c.get("workspace", {}).get("id") == ws_id]
    if not clients:
        state["hudOverrideText"] = f"WS {ws_id} IS EMPTY"
        state["hudOverrideColor"] = ""
        state["flashHud"] = True
        state["hudPreviewSeq"] = int(state.get("hudPreviewSeq", 0)) + 1
        save_state(state)
        return {"status": "empty", "workspace": ws_id}

    VAULT_DIR.mkdir(parents=True, exist_ok=True)
    stamp = int(time.time() * 1000)
    vid = f"ws{ws_id}-{stamp}"
    thumb_path = VAULT_DIR / f"{vid}.png"
    meta_path = VAULT_DIR / f"{vid}.json"

    # Capture crisp scaled screenshot before closing windows
    subprocess.run(
        ["grim", "-s", "0.45", str(thumb_path)],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        timeout=3.0,
    )

    ws_key = str(ws_id)
    ws_entry = state.get("workspaces", {}).get(ws_key, {})
    sensed = sense_workspace(ws_id)
    note = ws_entry.get("note") or sensed.get("summary") or f"WORKSPACE {ws_id}"
    color = ws_entry.get("color") or PALETTES.get(state.get("palette", "tokyo"), PALETTES["tokyo"])[(ws_id - 1) % 10]
    glyph = ws_entry.get("glyph") or ""

    windows = [build_relaunch_cmd(c) for c in clients]
    payload = {
        "id": vid,
        "origWs": ws_id,
        "note": note,
        "color": color,
        "glyph": glyph,
        "summary": sensed.get("summary") or "",
        "windowCount": len(windows),
        "windows": windows,
        "thumb": str(thumb_path) if thumb_path.exists() else "",
        "frozenAt": int(time.time()),
    }
    meta_path.write_text(json.dumps(payload, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")

    # Close all windows on this workspace using Omarchy's Lua dispatcher
    for c in clients:
        addr = c.get("address")
        if addr:
            subprocess.run(
                ["hyprctl", "dispatch", f'hl.dsp.window.close({{ window = "address:{addr}" }})'],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )

    # Clear workspace slot note so it is freshly available
    state.get("workspaces", {}).pop(ws_key, None)
    state["hudOverrideText"] = f"❄ CRYO-FROZEN // {note}"
    state["hudOverrideColor"] = color
    state["flashHud"] = True
    state["hudPreviewSeq"] = int(state.get("hudPreviewSeq", 0)) + 1
    save_state(state)
    return {"status": "frozen", "id": vid, "origWs": ws_id}


def thaw_workspace(state: dict, vid: str, target_ws: int | None, keep: bool) -> tuple[int, dict]:
    meta_path = VAULT_DIR / f"{vid}.json"
    if not meta_path.exists():
        return 1, {"status": "not_found", "id": vid}
    payload = json.loads(meta_path.read_text(encoding="utf-8"))
    orig_ws = int(payload.get("origWs", 1))
    clients = get_clients()
    occ = occupied_workspaces(clients)
    free = [i for i in range(1, 21) if i not in occ]

    if target_ws is None:
        if orig_ws not in occ:
            target_ws = orig_ws
        else:
            return 2, {"status": "occupied", "origWs": orig_ws, "free": free, "occupied": occ}

    # Switch to target workspace using Omarchy's Lua dispatcher and restore omabeacon metadata
    subprocess.run(
        ["hyprctl", "dispatch", f'hl.dsp.focus({{ workspace = "{target_ws}" }})'],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    time.sleep(0.05)

    entry: dict = {
        "note": payload.get("note", f"WS {target_ws}"),
        "color": payload.get("color", ""),
        "updatedAt": int(time.time()),
    }
    if payload.get("glyph"):
        entry["glyph"] = payload["glyph"]
    if not entry["color"]:
        entry.pop("color", None)
    state.setdefault("workspaces", {})[str(target_ws)] = entry

    for win in payload.get("windows", []):
        cmd = win.get("exec")
        if cmd:
            subprocess.Popen(
                cmd,
                shell=True,
                start_new_session=True,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )

    if not keep:
        thumb = payload.get("thumb")
        if thumb:
            try:
                Path(thumb).unlink(missing_ok=True)
            except OSError:
                pass
        meta_path.unlink(missing_ok=True)

    state["hudOverrideText"] = f"⚡ THAWED -> WS {target_ws} // {entry['note']}"
    state["hudOverrideColor"] = entry.get("color", "")
    state["flashHud"] = True
    state["hudPreviewSeq"] = int(state.get("hudPreviewSeq", 0)) + 1
    save_state(state)
    return 0, {"status": "thawed", "workspace": target_ws}


def main() -> int:
    parser = argparse.ArgumentParser(prog="omabeacon")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_set = sub.add_parser("set", help="Set workspace beacon note and optional color")
    p_set.add_argument("ws")
    p_set.add_argument("note")
    p_set.add_argument("--color", default=None)
    p_set.add_argument("--glyph", default=None)

    p_clear = sub.add_parser("clear", help="Clear workspace beacon")
    p_clear.add_argument("ws")

    p_fx = sub.add_parser("fx", help="Set lab FX mode")
    p_fx.add_argument("mode", choices=VALID_FX)

    p_auto = sub.add_parser("autosense", help="Toggle or set local auto-sense fallback")
    p_auto.add_argument("mode", choices=("on", "off", "toggle"))

    p_hud = sub.add_parser("hud", help="Toggle or set flash HUD")
    p_hud.add_argument("mode", choices=("on", "off", "toggle"))

    p_hudstyle = sub.add_parser("hudstyle", help="Set flash HUD style and optionally trigger demo")
    p_hudstyle.add_argument("style", choices=VALID_HUD_STYLES)
    p_hudstyle.add_argument("--demo", action="store_true")

    p_hudpos = sub.add_parser("hudpos", help="Set flash HUD position and optionally trigger demo")
    p_hudpos.add_argument("pos", choices=VALID_HUD_POS)
    p_hudpos.add_argument("--demo", action="store_true")

    p_hudsize = sub.add_parser("hudsize", help="Set flash HUD text size and optionally trigger demo")
    p_hudsize.add_argument("size", choices=VALID_HUD_SIZES)
    p_hudsize.add_argument("--demo", action="store_true")

    p_hudcolor = sub.add_parser("hudcolor", help="Set flash HUD color influence/flare and optionally trigger demo")
    p_hudcolor.add_argument("colorfx", choices=VALID_HUD_COLORFX)
    p_hudcolor.add_argument("--demo", action="store_true")

    p_hudcase = sub.add_parser("hudcase", help="Set flash HUD text casing and optionally trigger demo")
    p_hudcase.add_argument("casing", choices=VALID_HUD_CASE)
    p_hudcase.add_argument("--demo", action="store_true")

    p_palette = sub.add_parser("palette", help="Set active spectrum palette (overrides unlocked workspaces)")
    p_palette.add_argument("name", choices=tuple(PALETTES.keys()))
    p_palette.add_argument("--demo", action="store_true")

    p_lock = sub.add_parser("lock", help="Lock/unlock workspace color against palette overrides")
    p_lock.add_argument("ws")
    p_lock.add_argument("mode", nargs="?", choices=("on", "off", "toggle"), default="toggle")

    p_glyph = sub.add_parser("glyph", help="Set or clear emoji/glyph for a workspace")
    p_glyph.add_argument("ws")
    p_glyph.add_argument("glyph")
    p_glyph.add_argument("--demo", action="store_true")

    p_glyphpos = sub.add_parser("glyphpos", help="Set glyph position on flash HUD")
    p_glyphpos.add_argument("pos", choices=VALID_GLYPH_POS)
    p_glyphpos.add_argument("--demo", action="store_true")

    p_keybind = sub.add_parser("keybind", help="Update Hyprland keybinding for omabeacon")
    p_keybind.add_argument("combo")

    sub.add_parser("reset", help="Reset visual/HUD settings to defaults (keeps workspace notes)")

    p_extra = sub.add_parser("extrakeys", help="Enable/disable SUPER+F1..F10 (11-20) & F11/F12 cryo keys")
    p_extra.add_argument("mode", choices=("on", "off", "toggle"))

    sub.add_parser("freeze", help="Cryo-freeze current workspace into vault and free its slot")
    sub.add_parser("vault", help="Open Cryo Vault arcade wheel overlay")
    sub.add_parser("vault-list", help="List frozen vault items and occupied/free slots as JSON")

    p_thaw = sub.add_parser("thaw", help="Thaw a frozen workspace from vault")
    p_thaw.add_argument("id")
    p_thaw.add_argument("--ws", type=int, default=None)
    p_thaw.add_argument("--keep", action="store_true")

    p_vdel = sub.add_parser("vault-delete", help="Delete a frozen workspace from vault")
    p_vdel.add_argument("id")

    sub.add_parser("demo", help="Trigger a live flash HUD demo preview")

    p_sense = sub.add_parser("sense", help="Locally inspect current workspace windows/processes")
    p_sense.add_argument("ws", nargs="?", type=int, default=None)
    p_sense.add_argument("--json", action="store_true")

    p_get = sub.add_parser("get", help="Print state JSON")
    p_get.add_argument("ws", nargs="?", default=None)

    args = parser.parse_args()

    if args.cmd == "sense":
        res = sense_workspace(args.ws)
        if args.json:
            print(json.dumps(res, ensure_ascii=False))
        else:
            print(res["summary"])
        return 0

    state = load_state()

    if args.cmd == "get":
        if args.ws is not None:
            key = normalize_ws(args.ws)
            print(json.dumps(state["workspaces"].get(key, {}), ensure_ascii=False))
        else:
            print(json.dumps(state, indent=2, ensure_ascii=False))
        return 0

    if args.cmd == "set":
        key = normalize_ws(args.ws)
        note = args.note.strip()
        if not note:
            state["workspaces"].pop(key, None)
        else:
            entry = state["workspaces"].get(key, {})
            entry["note"] = note
            if args.color is not None:
                if args.color == "":
                    entry.pop("color", None)
                else:
                    entry["color"] = args.color
            if args.glyph is not None:
                if args.glyph == "":
                    entry.pop("glyph", None)
                else:
                    entry["glyph"] = args.glyph
            entry["updatedAt"] = int(time.time())
            state["workspaces"][key] = entry
        save_state(state)
        return 0

    if args.cmd == "clear":
        key = normalize_ws(args.ws)
        state["workspaces"].pop(key, None)
        save_state(state)
        return 0

    if args.cmd == "fx":
        state["fx"] = args.mode
        save_state(state)
        return 0

    if args.cmd == "autosense":
        if args.mode == "toggle":
            state["autoSense"] = not state["autoSense"]
        else:
            state["autoSense"] = args.mode == "on"
        save_state(state)
        return 0

    if args.cmd == "hud":
        if args.mode == "toggle":
            state["flashHud"] = not state["flashHud"]
        else:
            state["flashHud"] = args.mode == "on"
        save_state(state)
        return 0

    if args.cmd == "hudstyle":
        state["hudStyle"] = args.style
        if args.demo:
            state["flashHud"] = True
            state["hudPreviewSeq"] = int(state.get("hudPreviewSeq", 0)) + 1
        save_state(state)
        return 0

    if args.cmd == "hudpos":
        state["hudPos"] = args.pos
        if args.demo:
            state["flashHud"] = True
            state["hudPreviewSeq"] = int(state.get("hudPreviewSeq", 0)) + 1
        save_state(state)
        return 0

    if args.cmd == "hudsize":
        state["hudSize"] = args.size
        if args.demo:
            state["flashHud"] = True
            state["hudPreviewSeq"] = int(state.get("hudPreviewSeq", 0)) + 1
        save_state(state)
        return 0

    if args.cmd == "hudcolor":
        state["hudColorFx"] = args.colorfx
        if args.demo:
            state["flashHud"] = True
            state["hudPreviewSeq"] = int(state.get("hudPreviewSeq", 0)) + 1
        save_state(state)
        return 0

    if args.cmd == "hudcase":
        state["hudCase"] = args.casing
        if args.demo:
            state["flashHud"] = True
            state["hudPreviewSeq"] = int(state.get("hudPreviewSeq", 0)) + 1
        save_state(state)
        return 0

    if args.cmd == "palette":
        state["palette"] = args.name
        colors = PALETTES[args.name]
        for k, entry in state["workspaces"].items():
            if isinstance(entry, dict) and not entry.get("lockedColor", False):
                idx = (int(k) - 1) % len(colors)
                entry["color"] = colors[idx]
        if args.demo:
            state["flashHud"] = True
            state["hudPreviewSeq"] = int(state.get("hudPreviewSeq", 0)) + 1
        save_state(state)
        return 0

    if args.cmd == "lock":
        key = normalize_ws(args.ws)
        entry = state["workspaces"].get(key, {})
        if args.mode == "toggle":
            entry["lockedColor"] = not bool(entry.get("lockedColor", False))
        else:
            entry["lockedColor"] = args.mode == "on"
        state["workspaces"][key] = entry
        save_state(state)
        return 0

    if args.cmd == "glyph":
        key = normalize_ws(args.ws)
        entry = state["workspaces"].get(key, {})
        g = args.glyph.strip()
        if not g:
            entry.pop("glyph", None)
        else:
            entry["glyph"] = g
        if entry:
            state["workspaces"][key] = entry
        else:
            state["workspaces"].pop(key, None)
        if args.demo:
            state["flashHud"] = True
            state["hudPreviewSeq"] = int(state.get("hudPreviewSeq", 0)) + 1
        save_state(state)
        return 0

    if args.cmd == "glyphpos":
        state["glyphPos"] = args.pos
        if args.demo:
            state["flashHud"] = True
            state["hudPreviewSeq"] = int(state.get("hudPreviewSeq", 0)) + 1
        save_state(state)
        return 0

    if args.cmd == "keybind":
        combo = args.combo.strip()
        if not combo:
            return 1
        if BINDINGS_FILE.exists():
            txt = BINDINGS_FILE.read_text(encoding="utf-8")
            new_line = f'o.bind("{combo}", "Workspace beacon", "omarchy-shell shell toggle heelgueta.omabeacon")'
            pattern = r'o\.bind\("[^"]+",\s*"Workspace beacon",\s*"omarchy-shell shell toggle heelgueta\.omabeacon"\)'
            if re.search(pattern, txt):
                txt = re.sub(pattern, new_line, txt)
            else:
                txt = txt.rstrip() + "\n\n-- omabeacon plugin\n" + new_line + "\n"
            BINDINGS_FILE.write_text(txt, encoding="utf-8")
            subprocess.run(["hyprctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        state["keybind"] = combo
        save_state(state)
        return 0

    if args.cmd == "demo":
        state["hudPreviewSeq"] = int(state.get("hudPreviewSeq", 0)) + 1
        save_state(state)
        return 0

    if args.cmd == "reset":
        fresh = default_state()
        fresh["workspaces"] = state.get("workspaces", {})
        fresh["keybind"] = state.get("keybind", "SUPER + N")
        fresh["extraKeys"] = state.get("extraKeys", True)
        fresh["hudPreviewSeq"] = int(state.get("hudPreviewSeq", 0)) + 1
        save_state(fresh)
        return 0

    if args.cmd == "extrakeys":
        if args.mode == "toggle":
            state["extraKeys"] = not bool(state.get("extraKeys", True))
        else:
            state["extraKeys"] = args.mode == "on"
        apply_extra_keys(state["extraKeys"])
        save_state(state)
        return 0

    if args.cmd == "freeze":
        res = freeze_workspace(state)
        print(json.dumps(res, ensure_ascii=False))
        return 0

    if args.cmd == "vault":
        subprocess.run(
            ["omarchy-shell", "shell", "toggle", "heelgueta.omabeacon", '{"mode":"vault"}'],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        return 0

    if args.cmd == "vault-list":
        print(json.dumps(list_vault(), ensure_ascii=False))
        return 0

    if args.cmd == "thaw":
        code, res = thaw_workspace(state, args.id, args.ws, args.keep)
        print(json.dumps(res, ensure_ascii=False))
        return code

    if args.cmd == "vault-delete":
        meta_path = VAULT_DIR / f"{args.id}.json"
        if meta_path.exists():
            try:
                d = json.loads(meta_path.read_text(encoding="utf-8"))
                if d.get("thumb"):
                    Path(d["thumb"]).unlink(missing_ok=True)
            except Exception:
                pass
            meta_path.unlink(missing_ok=True)
        return 0

    return 1


if __name__ == "__main__":
    sys.exit(main())
